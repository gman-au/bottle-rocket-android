<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bottle_rocket_text_primary" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/bottle_rocket_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottle_rocket_light_disabled" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/bottle_rocket_light_disabled" />
        </shape>
    </item>
</selector>